# Application
APP_NAME=MultiAI Research Assistant
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Server-side API key (for external API calls — not needed for the UI)
API_KEY=dev-secret-change-me

# ── LLM Backend ───────────────────────────────────────────────────────────────
# Set to "groq" for cloud deployment (free), "ollama" for local development
LLM_BACKEND=groq

# Groq — free API key at https://console.groq.com
# Recommended model: llama3-8b-8192 (fast, free, high quality)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (only used when LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT_FAST=512
OLLAMA_NUM_PREDICT_REPORT=1400

# ── Pipeline ──────────────────────────────────────────────────────────────────
TURBO_PIPELINE=false
USE_LLM_PLANNER=true
FAST_PIPELINE=true
MAX_SUBTASKS=4
MAX_CONCURRENT_RESEARCH=3
REQUIRE_WEB_SEARCH=true
ENABLE_VERIFIER=true

# ── Optional persistence (disabled by default) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
POSTGRES_URL=postgresql+asyncpg://research:research@localhost:5432/research
POSTGRES_ENABLED=false
